# Required: create these in the Discord Developer Portal.
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_id_here

# Optional: register commands instantly in one development server.
# If omitted, deploy-commands registers commands globally.
DISCORD_GUILD_ID=your_development_server_id_here

# Optional station endpoint overrides.
# CAPITAL_STREAM_URL=https://media-sov.musicradio.com/CapitalUKMP3
# KISS_STREAM_URL=https://your-authorised-kiss-stream.example/stream.mp3
# BBC_1XTRA_STREAM_URL=https://your-authorised-bbc-1xtra-stream.example/live.m3u8
# TRUCKERSFM_STREAM_URL=http://your-authorised-truckersfm-stream.example/live
# LBC_STREAM_URL=https://media-sov.musicradio.com/LBCUKMP3
