{
  "name": "discord-radio-bot",
  "version": "1.0.0",
  "description": "An open-source Discord bot for playing live internet radio stations in voice channels.",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "eslint . && tsc -p tsconfig.json && node --test dist/tests/stations.test.js",
    "check:metadata": "tsc -p tsconfig.json && node dist/src/check-metadata.js",
    "check:streams": "tsc -p tsconfig.json && node dist/src/check-streams.js",
    "deploy-commands": "tsx src/register-commands.ts",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "start": "node dist/src/index.js",
    "test": "tsc -p tsconfig.json && node --test dist/tests/stations.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": ["discord", "discord-bot", "internet-radio", "radio", "voice"],
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22.12.0" },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.2",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.1",
    "eslint": "^9.35.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
